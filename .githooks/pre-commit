#!/bin/sh
# Runs the offline suite before every commit. Versioned here rather than in .git/hooks, which git does not
# track -- a hook nobody can clone is a hook that protects one machine.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip deliberately:       git commit --no-verify      (a WIP commit on a branch, nothing more)
#
# WHY A HOOK WHEN CI ALREADY RUNS THIS. CI answers after a push, which is after the commit that broke something
# is already in the history and, on a tag, already published. The hook answers before it exists. They are not
# redundant: CI is the authority (it builds on a clean machine with the same toolchain), the hook is the fast
# feedback that stops the obvious.
#
# It runs the TESTS only, not the plugin build: the suite compiles what it needs itself and takes seconds, while
# a full build.bat is ~50 s and would push people to --no-verify, which is worse than no hook at all.
#
# WHAT RUNS WHERE, so nobody adds a 50 s step here by mistake :
#   pre-commit (this file)  the offline suite  +  the in-game cross-check when the game can answer
#   push / CI               the offline suite again on a clean machine, AND the RELEASE shape -- CI has no
#                           src/plugin/aiohud_probes.cpp (untracked), so build.bat there compiles without
#                           AIOHUD_PROBES. That configuration is therefore covered on every push and does not
#                           need to be repeated here.
#   tag / CI                the release verification (zip, sidecar, addon parse, payload contents)

root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1

if [ ! -f tests.bat ]; then
    echo "pre-commit: tests.bat not found -- skipping (nothing to run)"
    exit 0
fi

echo "pre-commit: running the offline suite..."
# An ABSOLUTE Windows path, not "tests.bat": cmd does not resolve a relative name handed to it from this
# shell, and the failure reads as a failing test suite rather than as a path problem. Cost one confused
# minute the day the hook was written.
win_root=$(pwd -W 2>/dev/null || pwd)
out=$(cmd //c "$(echo "$win_root" | tr "/" "\\\\")\tests.bat" 2>&1)
rc=$?
if [ $rc -ne 0 ]; then
    echo "$out" | tail -30
    echo ""
    echo "pre-commit: TESTS FAILED -- commit refused."
    echo "            Fix them, or commit with --no-verify if you know why this one is allowed through."
    exit 1
fi

echo "$out" | grep -E "checks|\[tests\]" | tail -2

# ---- 2. THE IN-GAME CROSS-CHECK, when the game can answer -------------------------------------------------
# The offline suite cannot say whether our memory offsets are still right -- the harness plan named that as the
# half no test could reach. On a development machine it can: Windower reads the same facts by a completely
# different path, and the local dev/ tools (not in this repository) confront the two witnesses. It judges the
# DEPLOYED plugin, not the staged code : deploy before committing if the commit changes what the game reads.
# Without dev/ this step is skipped.
#
# THE RULES THIS OBEYS, because a hook that blocks for the wrong reason is worse than no hook:
#   * the game NOT running, or the addon not loaded, is NOT a failure -- it is skipped, out loud.
#   * a real mismatch IS a failure, and it blocks : our zone disagreeing with Windower's is exactly the
#     regression no other gate in this project can see.
#   * a zone transition can make one check disagree for a second, so a failure is retried ONCE before it
#     blocks. `--no-verify` remains the documented escape.
if [ -f dev/scripts/igtest.py ]; then
    py=$(command -v python 2>/dev/null || command -v py 2>/dev/null)
    if [ -z "$py" ]; then
        echo "pre-commit: python not found -- in-game cross-check skipped"
    else
        ig=$("$py" dev/scripts/igtest.py check --quiet 2>&1)
        igrc=$?
        case "$ig" in
            *"no answer for request"*)
                echo "pre-commit: in-game cross-check SKIPPED (game not running, or //lua load aiotest not done)" ;;
            *"did not answer //aio igstate"*)
                echo "pre-commit: in-game cross-check SKIPPED (the loaded AioHud predates //aio igstate -- deploy + //load)" ;;
            *)
                if [ $igrc -ne 0 ]; then
                    sleep 3                              # a zone transition can disagree for a second
                    ig=$("$py" dev/scripts/igtest.py check --quiet 2>&1)
                    igrc=$?
                fi
                echo "$ig" | grep -E "^\s+\[FAIL\]|UNCHECKED|passed,|evidence" | sed 's/^/           /'
                if [ $igrc -ne 0 ]; then
                    echo ""
                    echo "pre-commit: IN-GAME CROSS-CHECK FAILED -- commit refused."
                    echo "            AioHUD and Windower disagree about a fact one of them is reading wrong."
                    echo "            That is a real regression, or a client patch moved an offset."
                    echo "            --no-verify if you know why this one is allowed through."
                    exit 1
                fi ;;
        esac
    fi
fi

exit 0
